{
    "name": "FTCMS",
    "dockerFile": "Dockerfile",
    "build": {
        "args": {
            "USERNAME": "devuser"
        }
    },
    "mounts": [
        "source=${localWorkspaceFolder}/.fortls,target=/home/devuser/.fortls,type=bind,consistency=cached",
        "source=ftcms-build-vol,target=${containerWorkspaceFolder}/CMakeBuild,type=volume",
        "source=ftcms-git-vol,target=${containerWorkspaceFolder}/.git,type=volume"
    ],
    "runArgs": [
        "--hostname=ftcms-dev",
        "--shm-size=4g",
        "--privileged",
        "--cap-add=SYS_ADMIN",
        "--cap-add=SYS_PTRACE",
        "--security-opt",
        "seccomp=unconfined",
        "-v",
        "/sys/kernel/debug:/sys/kernel/debug"
    ],
    "remoteUser": "devuser",
    "customizations": {
        "vscode": {
            "extensions": [
                "MS-CEINTL.vscode-language-pack-ja",
                "ms-vscode.cpptools",
                "ms-azuretools.vscode-docker",
                "fortran-lang.linter-gfortran",
                "PKief.material-icon-theme",
                "ms-python.python",
                "tamasfe.even-better-toml",
                "ritwickdey.LiveServer",
                "ms-vscode.cmake-tools",
                "openai.chatgpt",
                "Anthropic.claude-code"
            ]
        }
    },
    "postCreateCommand": "sudo chown -R devuser:devuser /workspaces"
}